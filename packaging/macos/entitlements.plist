<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID 署名（Hardened Runtime）で使う権限。公証（notarization）には Hardened Runtime が必須。
  - audio-input: Hardened Runtime ではこれが無いとマイク入力が無音になる
  - allow-unsigned-executable-memory: Python / ctypes / ネイティブ拡張の実行に必要
  - disable-library-validation: 同梱の PySide6・MLX 等の dylib を読み込むため
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
